{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "art": "node scripts/art.ts",
    "art:check": "tsc -p art/tsconfig.json",
    "art:review": "node scripts/art.ts compose",
    "art:validate": "node scripts/art.ts validate",
    "ci": "npm run check && npm run build && npm test"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.13.6",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
