{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "preview": "vite preview",
    "build": "vite build && node scripts/noindex.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "art": "node scripts/art.ts",
    "art:check": "tsc -p art/tsconfig.json",
    "art:test": "node --test scripts/art/*.test.ts",
    "art:review": "node scripts/art.ts compose",
    "art:validate": "node scripts/art.ts validate",
    "ci": "npm run check && npm run build && npm test",
    "smoke": "playwright test",
    "bench": "node scripts/bench.ts",
    "flags": "node scripts/flags.ts",
    "audio": "node scripts/audio.ts",
    "videos": "node scripts/videos.ts",
    "multiplayer:off": "echo off | wrangler secret put MULTIPLAYER",
    "multiplayer:on": "wrangler secret delete MULTIPLAYER",
    "usage": "node scripts/usage.ts"
  },
  "devDependencies": {
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "flag-icons": "^7.5.0",
    "marked": "^18.1.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261006.1": true
  }
}
