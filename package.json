{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "preview": "vite preview",
    "build": "vite build && node scripts/noindex.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "art": "node scripts/art.ts",
    "art:check": "tsc -p art/tsconfig.json",
    "art:test": "node --test scripts/art/*.test.ts",
    "art:review": "node scripts/art.ts compose",
    "art:validate": "node scripts/art.ts validate",
    "ci": "npm run check && npm run build && npm test",
    "smoke": "playwright test",
    "bench": "node scripts/bench.ts",
    "multiplayer:off": "echo off | wrangler secret put MULTIPLAYER",
    "multiplayer:on": "wrangler secret delete MULTIPLAYER",
    "usage": "node scripts/usage.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.13.6",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "4.143.0"
  }
}
