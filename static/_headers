# Applied to every static asset response. The page CSP is `kit.csp` in svelte.config.js, written into each
# prerendered page; a meta tag can't set frame-ancestors, so that one directive is sent here.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Caching. The host's default is to ask again on every request (max-age=0, must-revalidate), which is right for the
# pages, which name the build's files, and for the résumé: a deploy shows at once. Only what follows is kept.
#
# Everything the build writes under /_app/immutable has its content's hash in its name (SvelteKit's scripts and styles,
# and Vite's assets: the fonts, the background tiles and the cut-outs), so a name never changes its bytes and a browser
# never asks for one twice.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# The sounds (npm run audio) are content-hashed, so a name never changes its bytes.
/audio/*
  Cache-Control: public, max-age=31536000, immutable

# The icons and the web manifest keep their names, so they are kept a day.
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400
